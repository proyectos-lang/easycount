# ============================================================
# EasyCount - Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# En Vercel: Settings > Environment Variables (agregar las 4).
# ============================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key (Project Settings > API > service_role)
# SOLO se usa en Server Actions (creacion de usuarios). NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Gemini (para "Recepcion por Factura" - lectura de facturas con IA)
# https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=AIza...
