# ============================================================
# EasyCount - Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# En Vercel: Settings > Environment Variables (agregar las 4).
# ============================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key (Project Settings > API > service_role)
# SOLO se usa en Server Actions (creacion de usuarios). NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Gemini (para "Recepcion por Factura" - lectura de facturas con IA)
# https://aistudio.google.com/apikey
# Solo se usa en el servidor (app/api/procesar-factura); no se expone al navegador.
GEMINI_API_KEY=AIza...

# Google Custom Search (buscador de imagenes de producto en la web)
# Solo se usa en el servidor (app/api/buscar-imagenes); no se expone al navegador.
# 1) API key: console.cloud.google.com > habilita "Custom Search API" > Credenciales > Clave de API
# 2) Motor (cx): programmablesearchengine.google.com > crear motor "buscar en toda la web" > activar "Image search"
# Si faltan, el buscador de imagenes muestra "no configurado" (no rompe nada).
GOOGLE_CSE_API_KEY=AIza...
GOOGLE_CSE_ID=...
